#!/bin/sh
#
#   update_script of ccu-addon-battery (MIT): the CCU addon handbook's steps (chapter 02). The
#   firmware unpacks the archive below /usr/local/tmp, cd's into it and runs
#   ./update_script HM-RASPBERRYMATIC. Exit 10 = fresh install, 0 = update.
#
#   The addon's tree is battery/ next to this script: bin/battery (the daemon), app/ (the web app,
#   served by the daemon at /addons/battery/), www/ (the settings page: the ccu-addon-kit frame and
#   its CGIs, served by the web server at /addons/battery-config/), lib/kit (the kit's Tcl library),
#   rc.d (the service script), etc/lighttpd.conf (the proxy rule). On openccu-lite the manifest
#   openccu-lite.json beside this script is read by the system before this script runs.
#
#   The data stays: etc/ (the settings) and var/ (the database, unless the user moved it) are never
#   touched by an update, and an uninstall leaves them for a reinstall as well.
#

ADDON=battery
ADDONS_DIR=/usr/local/addons
ADDON_DIR=$ADDONS_DIR/$ADDON
CONF_DIR=/usr/local/etc/config
# /addons/$WWW/: the settings page; the app itself is proxied at /addons/$ADDON/ (kit.json "www")
WWW=battery-config
WWW_DIR=$CONF_DIR/addons/www/$WWW
EXITCODE=10

# --- architecture check ---
# One package per architecture; ARCH beside this script names the package's (the build writes it
# and checks it against the daemon's ELF header). A package this system cannot run is refused
# here, before anything of the installed version is stopped or removed, so that version keeps
# running. The installers discard this script's output (OpenCCU shows "Error (13)", openccu-lite
# "unsupported platform"), so the message goes to the system log as well.
PKG_ARCH=$(cat ./ARCH 2>/dev/null)
MACHINE=$(uname -m)
# what the system runs, as the packages are named; a 64-bit ARM system and an armv8l (a 32-bit
# ARM system on a 64-bit kernel, piVCCU's container) run the armv7l package as well
case "$MACHINE" in
    x86_64|amd64) SYS_ARCH=x86_64; RUNS="x86_64" ;;
    aarch64|arm64) SYS_ARCH=aarch64; RUNS="aarch64 armv7l" ;;
    armv7*|armv8l) SYS_ARCH=armv7l; RUNS="armv7l" ;;
    *) SYS_ARCH=""; RUNS="" ;;
esac
case " $RUNS " in
    *" $PKG_ARCH "*) ;;
    *)
        PKG_VERSION=$(sed -n 's/^VERSION_ADDON=//p' ./$ADDON/versions 2>/dev/null)
        if [ -n "$SYS_ARCH" ]; then
            RIGHT="$ADDON-$SYS_ARCH-$PKG_VERSION.tar.gz"
            DE="Dieses Paket ist für ${PKG_ARCH:-?}, dieses System ist $MACHINE: bitte $RIGHT herunterladen. Die installierte Version bleibt unverändert."
            EN="This package is for ${PKG_ARCH:-?}, this system is $MACHINE: please download $RIGHT. The installed version is left unchanged."
        else
            DE="Dieses Paket ist für ${PKG_ARCH:-?}, dieses System ist $MACHINE: dafür gibt es kein Paket. Die installierte Version bleibt unverändert."
            EN="This package is for ${PKG_ARCH:-?}, this system is $MACHINE: there is no package for it. The installed version is left unchanged."
        fi
        echo "$DE" >&2
        echo "$EN" >&2
        logger -t $ADDON -p user.err "$DE" 2>/dev/null
        logger -t $ADDON -p user.err "$EN" 2>/dev/null
        exit 13
        ;;
esac
# --- end of the architecture check ---

mount | grep /usr/local >/dev/null 2>&1 || mount /usr/local

mkdir -p $ADDONS_DIR && chmod 755 $ADDONS_DIR
mkdir -p $CONF_DIR/addons/www && chmod 755 $CONF_DIR/addons/www
mkdir -p $CONF_DIR/rc.d

# an update: stop the running service through the previous version's script
if [ -f $CONF_DIR/rc.d/$ADDON ]; then
    EXITCODE=0
    $CONF_DIR/rc.d/$ADDON stop
fi

# everything but etc/ and var/ is the program's: nothing stale may survive an update
rm -rf "${ADDON_DIR:?}/bin" "${ADDON_DIR:?}/app" "${ADDON_DIR:?}/www" "${ADDON_DIR:?}/lib" "${ADDON_DIR:?}/rc.d" "${ADDON_DIR:?}/versions"
rm -f "${ADDON_DIR:?}/etc/lighttpd.conf"

mkdir -p $ADDON_DIR
cp -af $ADDON/bin $ADDON/app $ADDON/www $ADDON/lib $ADDON/rc.d $ADDON/versions $ADDON_DIR/
mkdir -p $ADDON_DIR/etc $ADDON_DIR/var
cp -af $ADDON/etc/lighttpd.conf $ADDON_DIR/etc/
chmod 755 $ADDON_DIR/bin/$ADDON $ADDON_DIR/bin/kit-run $ADDON_DIR/bin/update_addon $ADDON_DIR/bin/backup-snapshot $ADDON_DIR/bin/backup-restore $ADDON_DIR/rc.d
find $ADDON_DIR/www -name '*.cgi' -exec chmod 755 {} +

# the program directories are not worth a backup; the settings in etc/ are, and the database is
# there through its checked copy in backup/ (the daemon tags var/ while such a copy covers it)
touch $ADDON_DIR/bin/.nobackup $ADDON_DIR/app/.nobackup $ADDON_DIR/www/.nobackup $ADDON_DIR/lib/.nobackup

# links: -n because busybox ln -T refuses to replace an existing directory symlink. The settings
# page is /addons/$WWW/; the link named after the addon stays as well, pointing at the same tree:
# /addons/battery/ is proxied to the daemon before any file could be served from it, and
# openccu-lite keeps only the tree behind the link named after the addon world-readable when it
# closes the addon's files to other users (without it the settings page answers 404 there).
rmdir $WWW_DIR $CONF_DIR/addons/www/$ADDON 2>/dev/null
ln -sfn $ADDON_DIR/www $WWW_DIR
ln -sfn $ADDON_DIR/www $CONF_DIR/addons/www/$ADDON
ln -sf $ADDON_DIR/rc.d $CONF_DIR/rc.d/$ADDON

# the classic CCU reads the lighttpd rule from its own directory; openccu-lite makes its own
# validated copy of etc/lighttpd.conf and this directory is the system's there
LIGHTTPD_NEW=0
if ! grep -q '^LITE=' /VERSION 2>/dev/null && [ ! -x /usr/bin/occulited ]; then
    mkdir -p $CONF_DIR/lighttpd
    [ -f $CONF_DIR/lighttpd/$ADDON.conf ] || LIGHTTPD_NEW=1
    cp -f $ADDON_DIR/etc/lighttpd.conf $CONF_DIR/lighttpd/$ADDON.conf
    # the Einstellungen button of the WebUI (the settings page)
    touch $CONF_DIR/hm_addons.cfg
    $ADDON_DIR/bin/update_addon $ADDON ./$ADDON.cfg
fi

sync

# OpenCCU runs this live and does not reboot after an update: start the service again. The
# CCU3 firmware runs it in a chroot during the shutdown (S00InstallAddon); the boot starts it.
# openccu-lite starts the unit itself after the install.
if [ $EXITCODE -eq 0 ] && [ ! -f /etc/init.d/S00InstallAddon ]; then
    if grep -q '^LITE=' /VERSION 2>/dev/null || [ -x /usr/bin/occulited ]; then
        systemctl start addon-$ADDON.service 2>/dev/null || true
    else
        cd /
        $CONF_DIR/rc.d/$ADDON start
    fi
fi

# a new proxy rule on a running OpenCCU: lighttpd reads its fragments only when it starts (the
# CCU3 firmware installs during the shutdown, so its boot reads it). This script runs inside a
# request of that very lighttpd: the WebUI's cp_software.cgi execs /bin/install_addon and answers
# (and, for a fresh install, reboots) only when it has returned. A restart here tears down that
# request: the WebUI hangs in its dialog or shows "Error while loading the following file:
# /config/cp_software.cgi", no reboot follows and the service is not started. So `reload`, a
# graceful restart (running requests finish on the old server); where it fails, a restart detached
# and delayed until the WebUI's answer is out (the same as rc.d's uninstall and homematic-manager).
if [ $LIGHTTPD_NEW -eq 1 ] && [ ! -f /etc/init.d/S00InstallAddon ] && [ -x /etc/init.d/S50lighttpd ]; then
    if ! /etc/init.d/S50lighttpd reload >/dev/null 2>&1; then
        (sleep 5; /etc/init.d/S50lighttpd restart) >/dev/null 2>&1 </dev/null &
    fi
fi

exit $EXITCODE
