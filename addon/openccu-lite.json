{
  "format": 1,
  "id": "battery",
  "name": "Battery",
  "description": {
    "de": "Zeichnet die Batteriespannungen und Batterie-leer-Meldungen aller Geräte auf, erkennt Batteriewechsel und zeigt, wie lange Batterien halten.",
    "en": "Records the battery voltages and low-battery flags of every device, detects battery changes and shows how long batteries last."
  },
  "version": "1.5.9",
  "homepage": "https://github.com/hobbyquaker/ccu-addon-battery",
  "licence": "MIT",
  "changelog": "https://github.com/hobbyquaker/ccu-addon-battery/blob/main/CHANGELOG.md",
  "release": {
    "github": "hobbyquaker/ccu-addon-battery",
    "asset": "battery-{arch}-{version}.tar.gz"
  },
  "requires": {
    "architectures": ["aarch64", "x86_64", "armv7l"]
  },
  "ui": {
    "icon": "battery/www/icon.svg",
    "icon_dark": "battery/www/icon-dark.svg",
    "settings_url": "/addons/battery-config/settings.cgi",
    "session_header": true
  },
  "backup": {
    "hook": "bin/backup-snapshot",
    "staging": "backup",
    "timeout": 300,
    "size_hint_mb": 20,
    "restore": "bin/backup-restore"
  },
  "runtime": {
    "daemon": true,
    "needs": [],
    "api_scopes": ["rpc:read", "meta:read"],
    "groups": ["usbstorage"],
    "paths": ["/media"]
  }
}
